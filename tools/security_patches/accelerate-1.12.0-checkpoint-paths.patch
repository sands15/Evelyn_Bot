+def _validate_checkpoint_file(checkpoint_file, checkpoint_folder):
+    """Reject escapes and special files before reading an untrusted checkpoint."""
+    root = Path(checkpoint_folder).resolve()
+    try:
+        resolved = Path(checkpoint_file).resolve(strict=True)
+        contained = resolved.is_relative_to(root)
+        if not contained:
+            # Hub snapshots link to the same repository's flat blobs directory.
+            for snapshot in (root, *root.parents):
+                if (
+                    snapshot.parent.name == "snapshots"
+                    and snapshot.parent.parent.name.startswith("models--")
+                    and re.fullmatch(r"[0-9a-f]{40}", snapshot.name)
+                ):
+                    blobs = snapshot.parent.parent / "blobs"
+                    contained = (
+                        blobs.resolve() == blobs
+                        and resolved.parent == blobs
+                        and re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", resolved.name) is not None
+                    )
+                    break
+        if not contained or not resolved.is_file():
+            raise ValueError("Checkpoint files must be regular files inside the checkpoint or its Hub blob store.")
+    except (OSError, RuntimeError) as error:
+        raise ValueError("Checkpoint file cannot be resolved to a regular file.") from error
