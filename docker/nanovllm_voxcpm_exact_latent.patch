@@ -86,6 +86,28 @@ class VoxCPM2Runner(BaseModelRunner):
             .numpy()
         )
 
+    @torch.inference_mode()
+    def decode_latents(self, latents: np.ndarray) -> np.ndarray:
+        latents = np.asarray(latents, dtype=np.float32)
+        if latents.ndim != 2 or latents.shape[1] != self.feat_dim:
+            raise ValueError(
+                f"Invalid latent shape {latents.shape}; expected (frames, {self.feat_dim})"
+            )
+        if latents.shape[0] == 0:
+            return np.empty(0, dtype=np.float32)
+        latent_tensor = (
+            torch.from_numpy(latents.copy())
+            .to(device="cuda", dtype=torch.float32)
+            .transpose(0, 1)
+            .unsqueeze(0)
+        )
+        return (
+            self.vae.decode(latent_tensor)[0, 0]
+            .to(torch.float32)
+            .cpu()
+            .numpy()
+        )
+
     def run(self, seqs: list[RunnerTask[VoxCPM2Payload]], is_prefill: bool):
         positions = self.prepare_prefill_context(seqs) if is_prefill else self.prepare_decode_context(seqs)
