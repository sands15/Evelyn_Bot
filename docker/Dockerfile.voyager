FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/evelyn_core/runtime

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends nodejs npm ca-certificates && \
    npm install -g @openai/codex@0.128.0 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY docker/requirements.voyager.txt /app/docker/requirements.voyager.txt
RUN python -m pip install --upgrade pip && \
    pip install --no-cache-dir -r /app/docker/requirements.voyager.txt

COPY evelyn_core/runtime /app/evelyn_core/runtime

EXPOSE 8765 8787
