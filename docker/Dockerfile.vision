FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV CUDA_HOME=/usr/local/cuda
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV PYTHONPATH=/app/evelyn_core/runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    libgomp1 \
    python3 \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements.vision.txt /tmp/requirements.vision.txt

RUN python3 -m venv --system-site-packages "$VIRTUAL_ENV" \
    && pip install --upgrade pip \
    && pip install \
        torch==2.11.0+cu128 \
        torchvision==0.26.0+cu128 \
        --index-url https://download.pytorch.org/whl/cu128 \
    && pip install -r /tmp/requirements.vision.txt

# Falcon-OCR remote model code imports requests at lazy-load time.
RUN pip install requests==2.34.2

# Falcon-OCR's CUDA/Triton path builds a small Python extension on first use.
# Keep this after the expensive Python dependency layer so image rebuilds can
# reuse the model runtime cache when only the compiler header package changes.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 evelyn \
    && useradd --uid 10001 --gid 10001 --no-create-home evelyn

ARG EVELYN_SOURCE_REVISION=unversioned

COPY docker/falcon_ocr_snapshot.lock.json /app/docker/falcon_ocr_snapshot.lock.json
COPY evelyn_core/runtime /app/evelyn_core/runtime
COPY tools/provision_falcon_ocr_snapshot.py /app/tools/provision_falcon_ocr_snapshot.py

ENV EVELYN_IMAGE_SOURCE_REVISION=${EVELYN_SOURCE_REVISION}

USER 10001:10001

EXPOSE 8891

CMD ["python", "-m", "evelyn_core.vision_service"]
