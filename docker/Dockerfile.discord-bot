FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/evelyn_core/runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ffmpeg \
      libopus0 \
      libportaudio2 \
      libsndfile1 && \
    rm -rf /var/lib/apt/lists/*

COPY docker/requirements.discord-bot.txt /app/docker/requirements.discord-bot.txt
RUN python -m pip install --upgrade pip && \
    pip install --no-cache-dir -r /app/docker/requirements.discord-bot.txt

COPY . /app

ENV EVELYN_CORE_RUNTIME=/app/evelyn_core/runtime
ENV EVELYN_CORE_ROOT=/app/evelyn_core
ENV EVELYN_PROJECT_ROOT=/app

CMD ["python", "main.py"]
