FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04@sha256:05de765c12d993316f770e8e4396b9516afe38b7c52189bce2d5b64ef812db58 AS stt-builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV CUDA_HOME=/usr/local/cuda
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV PYTHONPATH=/app/evelyn_core/runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    python3 \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements.stt.txt /tmp/requirements.stt.txt

RUN python3 -m venv "$VIRTUAL_ENV" \
    && pip install --upgrade pip==26.2.1 \
    && pip install \
        torch==2.9.1+cu128 \
        torchaudio==2.9.1+cu128 \
        torchvision==0.24.1+cu128 \
        --index-url https://download.pytorch.org/whl/cu128 \
    && pip install -r /tmp/requirements.stt.txt \
    && pip check \
    && mkdir -p /opt/evelyn \
    && pip freeze --all > /tmp/stt-package-set.unsorted \
    && LC_ALL=C sort /tmp/stt-package-set.unsorted > /opt/evelyn/stt-package-set.txt \
    && rm -f /tmp/stt-package-set.unsorted \
    && sha256sum /opt/evelyn/stt-package-set.txt > /opt/evelyn/stt-package-set.sha256

FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04@sha256:05de765c12d993316f770e8e4396b9516afe38b7c52189bce2d5b64ef812db58

ARG EVELYN_SOURCE_REVISION=unversioned
ARG EVELYN_STT_DOCKERFILE_SHA256=unversioned
ARG EVELYN_STT_REQUIREMENTS_SHA256=unversioned

LABEL org.opencontainers.image.revision="${EVELYN_SOURCE_REVISION}" \
    org.opencontainers.image.base.digest="sha256:05de765c12d993316f770e8e4396b9516afe38b7c52189bce2d5b64ef812db58" \
    io.evelyn.stt.dockerfile.sha256="${EVELYN_STT_DOCKERFILE_SHA256}" \
    io.evelyn.stt.requirements.sha256="${EVELYN_STT_REQUIREMENTS_SHA256}"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV CUDA_HOME=/usr/local/cuda
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV PYTHONPATH=/app/evelyn_core/runtime

WORKDIR /app

# Triton discovers the physical GPU only after container start and JIT-compiles
# its CPython launch stub then. Keep the runtime toolchain to the two required
# packages; the full builder toolchain remains outside this final stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gcc \
    libgomp1 \
    python3 \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=stt-builder /opt/venv /opt/venv
COPY --from=stt-builder /opt/evelyn /opt/evelyn

COPY evelyn_core/runtime/evelyn_core /app/evelyn_core/runtime/evelyn_core

EXPOSE 8892

CMD ["python", "-m", "evelyn_core.stt_service"]
