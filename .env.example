DISCORD_BOT_TOKEN=여기에_디스코드_봇_토큰
# Optional personal scope for verified recent-context handoff between the
# Control Page/Fast Control owner and Discord. Both IDs are required; the
# bridge stays fail-closed when either ID is missing.
CROSS_SURFACE_CONTINUITY_ENABLED=false
CROSS_SURFACE_CONTINUITY_GUILD_ID=0
CROSS_SURFACE_CONTINUITY_USER_ID=0
# Optional keyed authenticity for relationship-continuity checkpoints.
# Use an absolute 32+ byte key file outside this repository. For Docker,
# include docker-compose.continuity-auth.yml; it mounts this file read-only.
# EVELYN_CONTINUITY_AUTH_KEY_FILE=C:/Users/you/.evelyn-secrets/continuity-auth.key
# Optional external monotonic anchor directory. Keep it outside this
# repository and runtime_artifacts, pre-create it, and restrict write access
# to the Evelyn service account. The Docker override requires this path.
# EVELYN_CONTINUITY_AUTH_ANCHOR_DIR=C:/Users/you/.evelyn-continuity-anchor
# Set true for one startup only when explicitly adopting existing unsigned
# checkpoints, then return it to false.
EVELYN_CONTINUITY_AUTH_BOOTSTRAP=false
# Optional independent authenticity key shared by the memory provenance
# correction and permanent-deletion journals. The two journals use separate
# HMAC domains, scopes, chain heads, and anchor files. Do not reuse the
# relationship-continuity key. Keep this absolute 32+ byte file outside the
# repository and bot_memory. For Docker, include
# docker-compose.memory-integrity.yml.
# EVELYN_MEMORY_INTEGRITY_KEY_FILE=C:/Users/you/.evelyn-secrets/memory-integrity.key
# Optional external monotonic anchor directory. Pre-create it outside the
# repository, bot_memory and runtime_artifacts; the key file must not live
# inside this writable anchor directory. Restrict writes to the Bot API
# service account.
# EVELYN_MEMORY_INTEGRITY_ANCHOR_DIR=C:/Users/you/.evelyn-memory-integrity-anchor
# Set true for one coordinated startup only when adopting existing unsigned
# correction/deletion history. A first approved deletion can initialize a
# genuinely empty deletion ledger; startup/read alone does not. Return to false
# after every adopted journal reports verified authenticity and external-anchor
# state. Rollback protection requires both the key and external anchor;
# key-only cannot detect journal+head past replay together.
EVELYN_MEMORY_INTEGRITY_BOOTSTRAP=false
# Optional host path overrides for Docker Compose. Defaults use USERPROFILE.
# Use forward slashes in Windows paths.
# EVELYN_LLAMA_CPP_DIR=C:/Users/you/llama.cpp
# Main/GPU0-only native build selector. It defaults to build-sm120-v1 and
# fails closed when that native 120a build is absent. GPU1 LLM services keep
# the multi-architecture EVELYN_LLAMA_CPP_DIR/build.
# EVELYN_MAIN_LLM_BUILD_DIR=C:/Users/you/llama.cpp/build-sm120-v1
# EVELYN_OMNIVOICE_SERVER_DIR=C:/Users/you/omnivoice-server
# EVELYN_OMNIVOICE_PROFILES_DIR=C:/Evelyn/omnivoice_profiles
# Pre-existing Hugging Face home; the provisioner uses its hub/ child:
# python tools/provision_falcon_ocr_snapshot.py download --cache-dir C:/Users/you/.cache/huggingface
# Runtime mounts this directory read-only and Falcon-OCR stays offline.
# EVELYN_HUGGINGFACE_CACHE_DIR=C:/Users/you/.cache/huggingface
# Dedicated directory containing auth.json and optionally config.toml.
# Do not point this at your live ~/.codex directory.
# EVELYN_CODEX_CREDENTIALS_DIR=C:/Evelyn/runtime_artifacts/secrets/codex_device_home
# EVELYN_HOST_PROJECT_ROOT=C:/Evelyn
# EVELYN_WORKSPACE_MUTATION_AUTH_TOKEN is an ephemeral launcher-generated
# Control Page <-> Windows Host capability. Do not persist it in this file.
LLM_SERVER_URL=http://127.0.0.1:9820/v1/chat/completions
LLM_MODEL_NAME=gemma-4-12B-it-IQ4_XS-text-only
# Stable GPU roles: latency-critical Main+TTS on the realtime GPU, STT on ingress.
# Change these only through a controlled benchmark; do not migrate a live turn.
EVELYN_REALTIME_GPU_ID=0
EVELYN_INGRESS_GPU_ID=1
MAIN_LLM_CONTEXT=8192
MAIN_LLM_CHAT_CONTENT_FORMAT=openai
# Main startup hashes the exact GGUF, llama-server binary, and the actual
# template/reasoning argument vector into its read-only Prompt ABI volume.
# Native deployments may instead provide the three exact SHA256 values through
# MAIN_LLM_MODEL_SHA256, MAIN_LLM_SERVER_SHA256, and
# MAIN_LLM_RUNTIME_TEMPLATE_SHA256. Never substitute a human version label.
MAIN_LLM_PROMPT_ASSETS_EMBEDDED=true
# Keep Voyager background skill indexing off the realtime Main/TTS GPU.
VOYAGER_SKILL_LLM_URL=http://sub_llm:9821/v1/chat/completions
VOYAGER_SKILL_MODEL_NAME=gemma-4-E4B-it-Q4_K_M-text-only
# llama.cpp TTFT/prefill tuning; override only after an A/B run on the target GPU.
MAIN_LLM_N_PARALLEL=1
MAIN_LLM_BATCH_SIZE=2048
MAIN_LLM_UBATCH_SIZE=2048
MAIN_LLM_CACHE_RAM_MIB=8192
MAIN_LLM_CACHE_REUSE=256
MAIN_LLM_SWA_FULL_ENABLED=1
MAIN_LLM_CUDA_GRAPH_OPT=1
SUMMARY_LLM_URL=http://127.0.0.1:9821/v1/chat/completions
SUMMARY_MODEL_NAME=gemma-4-E4B-it-Q4_K_M-text-only
ROUTER_MODEL_NAME=gemma-4-E2B-it-Q4_K_M-text-only
SPECIALIST_LLM_TIMEOUT_SEC=6
MINDCRAFT_LLM_BROKER_URL=http://127.0.0.1:8798/internal/mindcraft-llm
# Absolute path to the local broker token; never store the token itself here.
# MINDCRAFT_LLM_BROKER_TOKEN_FILE=C:/Evelyn/runtime_artifacts/secrets/mindcraft-llm/token
QWEN_ADMISSION_QUEUE_TIMEOUT_SEC=30
BOT_MEMORY_DIR=C:\Evelyn\bot_memory
EVELYN_PAGE_URL=https://sands15.github.io/Evelyn_Bot/
# Optional comma-separated cross-origin allowlist for the local Control Page API.
# Keep empty for the default loopback-only policy.
CONTROL_PAGE_ALLOWED_ORIGINS=
MEMORY_RAW_LIMIT=400
MEMORY_RAW_CONTEXT_LIMIT=6
MEMORY_WORKING_SUMMARY_MAX_CHARS=700
MEMORY_ROW_MAX_CHARS=120
MEMORY_COGNITIVE_RAW_LIMIT=4
MEMORY_LONGTERM_RAW_LIMIT=6
MEMORY_VAULT_RAW_RETRIEVE_LIMIT=4
MEMORY_VAULT_DAYS=7
COGNITIVE_MAX_TOKENS=120
COGNITIVE_TIMEOUT_SEC=8
ASK_CONFIDENCE_THRESHOLD_TEXT=0.75
ASK_CONFIDENCE_THRESHOLD_VOICE=0.85

OMNIVOICE_SERVER_URL=http://127.0.0.1:8880
OMNIVOICE_MODEL=omnivoice
OMNIVOICE_VOICE=clone:evelyn
OMNIVOICE_LANGUAGE=ko
OMNIVOICE_STREAM=true
OMNIVOICE_NUM_STEP=12
OMNIVOICE_TIMEOUT_SEC=180
LOCAL_BRIDGE_BOT_API_BASE=http://127.0.0.1:8798
LOCAL_BRIDGE_TTS_ENABLED=true
LOCAL_BRIDGE_MIN_TEXT_CHARS=2
LOCAL_BRIDGE_STT_STREAMING_ENABLED=true

STT_MODEL_NAME=Qwen/Qwen3-ASR-1.7B
STT_LANGUAGE=ko
STT_COMPUTE_TYPE=float16
STT_FORCE_LANGUAGE=true
STT_FORCE_PUNCTUATION=true
# Discord completed-audio single-final rollout flag; packet-time streaming is pending.
STT_STREAMING_ENABLED=true
STT_FULL_RESCORING_ENABLED=false
STT_VLLM_GPU_MEMORY_UTILIZATION=0.35

# Sensitive raw/STT microphone captures. Enable only for a bounded debug session.
VOICE_DEBUG_SAVE_AUDIO=false
VOICE_DEBUG_AUDIO_DIR=debug_audio
VOICE_DEBUG_MAX_FILES_PER_GUILD=200
VOICE_DEBUG_MAX_AGE_DAYS=7
VOICE_DEBUG_MAX_TOTAL_MB_PER_GUILD=256
VOICE_DEBUG_PRESERVE_NEWEST=10

# Rotate Evelyn-owned text logs at 25 MiB and keep four backups.
EVELYN_LOG_MAX_BYTES=26214400
EVELYN_LOG_BACKUP_COUNT=4
EVELYN_STATUS_LOG_INTERVAL_SEC=30

SILERO_VAD_ONNX=true
SILERO_VAD_THRESHOLD=0.35
VOICE_ENV_FLATNESS_MAX=0.72
VOICE_HUMAN_BAND_RATIO_MIN=0.38
VOICE_ENV_RMS_MAX=0.020
OPUS_ERROR_TO_SILENCE=true

AUTO_JOIN_VOICE=true
# Mineflayer / Minecraft bot defaults (matches evelyn_core/start_env.bat)
MINEFLAYER_HOST=127.0.0.1
MINEFLAYER_PORT=25565
MINEFLAYER_USERNAME=EvelynBot
MINEFLAYER_AUTH=offline
MINEFLAYER_PROFILES_FOLDER=./mineflayer_profiles
# MINEFLAYER_VERSION=1.21.1
#
# For Microsoft auth, switch the login fields below and keep the password out of .env:
# MINEFLAYER_USERNAME=your_microsoft_email@example.com
# MINEFLAYER_AUTH=microsoft
# MINEFLAYER_PROFILES_FOLDER=./bot_profiles
# Set password separately before launch (PowerShell example):
#   $env:MINEFLAYER_PASSWORD='your-password'

# Voyager action generation gateway
VOYAGER_ACTION_BACKEND=disabled
MINDCRAFT_CODEX_ENABLED=false
VOYAGER_CODEX_GATEWAY_HOST=127.0.0.1
VOYAGER_CODEX_GATEWAY_PORT=8787
VOYAGER_CODEX_GATEWAY_URL=http://127.0.0.1:8787/codex/action
# The isolated Compose gateway creates its token in the dedicated
# codex_gateway_token volume.
# VOYAGER_CODEX_GATEWAY_TOKEN=
# VOYAGER_CODEX_GATEWAY_TOKEN_FILE=

# Legacy direct task auto-start is disabled by the world-action lease policy.
VOYAGER_AUTO_START=false
# Split deployments set this only on delegated Discord workers. The Bot API
# owner itself leaves it empty; docker-compose.fast-control.yml wires it.
MINECRAFT_WORLD_LEASE_OWNER_URL=
MINECRAFT_CONNECT_READY_TIMEOUT_SEC=60
MINECRAFT_WORLD_LEASE_CONNECT_TIMEOUT_SEC=480
MINECRAFT_WORLD_LEASE_MUTATION_TIMEOUT_SEC=30
MINECRAFT_CONTROL_MUTATION_TIMEOUT_SEC=30
MINECRAFT_LAZY_START_TIMEOUT_SEC=300
# Leave VOYAGER_START_MODE empty to let the service pick the upstream default mode from the goal.
VOYAGER_START_MODE=
VOYAGER_START_GOAL=discovering as many diverse things as possible

WAKE_WORD=이블린
VOICE_MIN_TEXT_LEN=4
VOICE_MIN_TRANSCRIBED_LEN=6
VOICE_MIN_AUDIO_SEC=0.6
VOICE_CONNECT_TIMEOUT=45
VOICE_CONNECT_RETRIES=2
VOICE_CONNECT_RETRY_DELAY_SEC=1.5
VOICE_TIMING_LOG_THRESHOLD_MS=3000
VOICE_REPLY_COOLDOWN_SEC=2.5
VOICE_POST_TTS_IGNORE_SEC=1.2
LOCAL_MIC_MAX_SILENCE_MS=500
LOCAL_MIC_TTS_ACTIVE_MAX_SILENCE_MS=350
SPEAKER_VERIFICATION_ENABLED=true
SPEAKER_VERIFICATION_APPLY_TO=local_mic
SPEAKER_VERIFICATION_ENROLL_DIR=bot_profiles/voiceprints/junghoon
SPEAKER_VERIFICATION_THRESHOLD=0.45
SPEAKER_VERIFICATION_MIN_AUDIO_SEC=0.45
SPEAKER_VERIFICATION_MAX_AUDIO_SEC=3.0
SPEAKER_VERIFICATION_DEVICE=auto
VOICE_BARGE_IN_MERGE_WINDOW_SEC=0.4
VOICE_BARGE_IN_ADAPTIVE_MERGE_ENABLED=true
VOICE_BARGE_IN_TTS_INTERRUPTED_WINDOW_SEC=0.9
VOICE_BARGE_IN_INCOMPLETE_UTTERANCE_WINDOW_SEC=1.2
VOICE_BARGE_IN_QUESTION_WINDOW_SEC=0.5
VOICE_SIMILARITY_BLOCK=0.88
