      "checks": [
        {
          "kind": "tcp",
          "timeout_ms": 300
        },
        {
          "kind": "http",
          "path": "/api/control-page/state",
          "timeout_ms": 6000,
          "expect_status": 200,
          "expect_json": {
            "ok": true
          }
        }
      ],
      "launcher": "launchers/start_bot.ps1",
      "repair": {
        "allowed": true,
        "strategy": "start_if_down",
        "requires_confirm": true,
        "cooldown_sec": 30
      }
